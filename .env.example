# Meridian Financial — environment configuration
# Copy to `.env` and adjust. Every value has a working default; the app runs with no .env at all.

# Database. Defaults to SQLite inside ./data. For deployment, point at PostgreSQL —
# the schema is portable and this is intended to be the only change needed.
#   SQLite:      sqlite:///data/meridian.db
#   PostgreSQL:  postgresql://user:pass@host:5432/meridian
DATABASE_URL=sqlite:///data/meridian.db

# HTTP. The server binds to 127.0.0.1 only; PORT falls back through 8788-8799 if taken.
PORT=8787

# Directory for all app-written data (database, uploaded documents, secrets).
DATA_DIR=data

# Session signing secret. Leave unset to auto-generate one on first run
# (persisted to DATA_DIR/.jwt_secret). Set explicitly for deployments.
#JWT_SECRET=

# Session lifetime in hours.
SESSION_HOURS=24

# AI — local model via Ollama. Must resolve to a loopback address; the app refuses
# to use a non-loopback AI endpoint at startup.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Active LLM provider: "ollama" (default, fully local) or "anthropic" (OFF by default;
# sends data off-device — requires explicit opt-in and an API key).
LLM_PROVIDER=ollama
#ANTHROPIC_API_KEY=
